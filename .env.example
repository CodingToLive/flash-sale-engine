# Copy to .env and fill in. Never commit the real .env file.
#
# --- used by docker-compose.yml (local dev) ---
ADMIN_SECRET=demo-admin-secret
EMAIL_ENABLED=false

# --- additionally used by docker-compose.prod.yml (Oracle VM only, see infra/oracle-vm-setup.md) ---
DB_PASSWORD=change-me
GHCR_NAMESPACE=your-github-username
CADDY_ADDRESS=your-subdomain.duckdns.org

# Optional opt-in email delivery (SmtpEmailSender in notification-service).
# Leave EMAIL_ENABLED=false to keep notifications as in-page previews only - no
# SMTP account is required for the demo to work end-to-end.
EMAIL_FROM=no-reply@your-subdomain.duckdns.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
